#!/bin/bash
# `mum` pinned to the frozen 2026-07-16 eval corpus. refresh is hard-blocked.
# The freeze dir holds corpus-index.db, corpus-manifest.json, and summaries/ — a
# complete MARIN_CACHE, so no live mirror is touched.
if [ "$1" = "refresh" ]; then
  echo "mum-frozen: refresh is disabled (frozen-corpus eval run)" >&2; exit 1
fi
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# Which freeze to search. score.py reads the same variable, so retrieval and the
# hallucination gate can never end up on different corpora.
FREEZE="${MARIN_EVAL_FREEZE:-2026-07-16}"
if [ ! -f "$ROOT/evals/corpus/$FREEZE/corpus-index.db" ]; then
  echo "mum-frozen: no corpus-index.db in evals/corpus/$FREEZE" >&2; exit 1
fi
export MARIN_CACHE="$ROOT/evals/corpus/$FREEZE"
export MARIN_MAX_AGE_DAYS=3650
export MARIN_STALE_HOURS=99999
exec mum "$@"
